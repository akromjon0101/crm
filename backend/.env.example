PORT=5001
NODE_ENV=development

# Database — SQLite file location.
# Optional: leave unset for local dev (defaults to backend/crm.db).
# On a VPS, point this outside the deployed code directory so redeploys /
# `git pull` never touch it, e.g. DB_PATH=/var/lib/educrm/crm.db
# DB_PATH=./crm.db

# JWT
# REQUIRED in production — the app refuses to start with this placeholder.
# Generate a real one with: openssl rand -base64 48
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# CORS — REQUIRED in production. Must be your deployed frontend's exact
# origin (scheme + host, no trailing slash), e.g. https://crm.example.com
CLIENT_URL=http://localhost:5173

# Initial superadmin account — production only. If both are set (password
# >=8 chars), it's created automatically on first boot. If unset in
# production, no default admin is created at all (there is no hardcoded
# fallback) — run `node create-admin.js` instead, any time, to create one
# interactively. Outside production, superadmin@crm.uz / password is always
# available for local dev/demo, regardless of these.
# INITIAL_SUPERADMIN_EMAIL=you@yourcompany.com
# INITIAL_SUPERADMIN_PASSWORD=

# Eskiz SMS (optional — leave blank to disable SMS sending)
ESKIZ_EMAIL=your_eskiz_email@example.com
ESKIZ_PASSWORD=your_eskiz_password
ESKIZ_FROM=4546

# Used automatically by `vite build`. Frontend is deployed on Vercel, backend
# on Railway — different origins, so this must be the backend's absolute URL
# (not a relative /api path). CORS on the backend is configured via its
# CLIENT_URL env var, which must match this deployment's Vercel URL exactly.
VITE_API_URL=https://crm-backend-production-d330.up.railway.app/api

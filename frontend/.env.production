# Used automatically by `vite build`. The VPS setup in DEPLOY.md serves the
# built frontend and the backend from the same Nginx origin (backend proxied
# under /api), so a relative path is all that's needed — no CORS involved.
# If you deploy frontend and backend on different domains instead, override
# this to the backend's absolute URL, e.g. https://api.example.com/api
VITE_API_URL=/api
